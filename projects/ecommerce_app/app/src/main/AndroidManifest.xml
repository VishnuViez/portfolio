<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".ShopApp"
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ShopVishnu.NoActionBar">

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.ShopVishnu.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Use NoActionBar for activities that use a Toolbar via setSupportActionBar -->
        <activity android:name=".ui.home.MainActivity"
            android:theme="@style/Theme.ShopVishnu.NoActionBar" />
        <activity android:name=".ui.product.ProductDetailActivity"
            android:theme="@style/Theme.ShopVishnu.NoActionBar" />
        <activity android:name=".ui.cart.CartActivity"
            android:theme="@style/Theme.ShopVishnu.NoActionBar" />
        <activity android:name=".ui.orders.OrdersActivity"
            android:theme="@style/Theme.ShopVishnu.NoActionBar" />
    </application>
</manifest>
